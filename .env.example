# Copy to .env and fill in. Never commit real values.
# Source of truth: Accountabul-owned Supabase project (not Lovable Cloud).

# Backend (Supabase) — client-visible by design
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend — server side (same values as above, read during SSR)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=

# SECRET — server only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Nationwide property ingestion (Property Intelligence port) — SECRET, server only.
# A direct PostgreSQL connection string for the property_core/property_ingest/
# property_api schema (supabase/migrations/2026092*). Separate from the app's own
# Supabase connection above since this schema may eventually live on its own
# Postgres target. Read only by the live-ingestion entrypoint
# (nationwide-postgres-client.server.ts), reached via the ops route below.
NATIONWIDE_DATABASE_URL=

# The live property_ingest.source_definitions / geography_catalog row IDs for
# mo_st_louis_lra_inventory_v1, knowable only once the nationwide migrations are
# applied. POST /api/internal/ops/nationwide-st-louis-lra-ingest answers 503
# while either is unset, which keeps the staged rollout inert by default.
NATIONWIDE_ST_LOUIS_LRA_SOURCE_DEFINITION_ID=
NATIONWIDE_ST_LOUIS_LRA_JURISDICTION_ID=

# Payments (Stripe) — SECRET, server only
# Live catalog account: acct_YOUR_ACCOUNT_ID (Accountabul CSD)
STRIPE_ACCOUNT_ID=
# Use separate environment-specific restricted keys; never expose these to VITE_* variables.
STRIPE_MEMBER_RESTRICTED_KEY=
STRIPE_OPERATIONS_RESTRICTED_KEY=
STRIPE_WEBHOOK_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook URL: ${PUBLIC_SITE_URL}/api/public/webhooks/stripe
STRIPE_PAID_COMMENT_PRICE_ID=
# Must be true only in an authorized server environment; enables catalog/refund mutations.
STRIPE_OPERATIONS_MUTATIONS_ENABLED=false
# When true, signed test-mode Stripe events are rejected.
STRIPE_LIVE_MODE=false
# Launch catalog fallbacks if membership_tiers.stripe_price_id_* is empty:
# STRIPE_MEMBERSHIP_PRICE_BUSINESS_HOSTING_MONTHLY=
# STRIPE_MEMBERSHIP_PRICE_STARTER_MONTHLY=
# STRIPE_MEMBERSHIP_PRICE_STARTER_ANNUAL=
# STRIPE_MEMBERSHIP_PRICE_PROFESSIONAL_MONTHLY=
# STRIPE_MEMBERSHIP_PRICE_PROFESSIONAL_ANNUAL=
# STRIPE_MEMBERSHIP_PRICE_PORTFOLIO_MONTHLY=
# STRIPE_MEMBERSHIP_PRICE_PORTFOLIO_ANNUAL=

# Moderation — SECRET, server only
OPENAI_API_KEY=

# Private Lovable operations console — SECRET, server only in both deployments
OPERATIONS_API_KEY=
OPERATIONS_OPERATOR_EMAIL=
# Format: pbkdf2_sha256$310000$<base64 salt>$<base64 hash>
# Escape each $ as \$ — Vite dotenv-expand treats unescaped $ as interpolation.
OPERATIONS_OPERATOR_PASSWORD_HASH=
OPERATIONS_OPERATOR_ROLE=operations_admin
# Local walkthrough only. Leave empty in deployed environments.
# Used only when SUPABASE_SERVICE_ROLE_KEY is unset.
OPS_LOCAL_DATA_EMAIL=
OPS_LOCAL_DATA_PASSWORD=

# Restream OAuth / bridge — SECRET, server only
# Shelved for Accountabul Live. Keep the values empty unless the Restream branch is revived.
RESTREAM_CLIENT_ID=
RESTREAM_CLIENT_SECRET=
RESTREAM_REDIRECT_URI=
RESTREAM_OAUTH_SUCCESS_URL=
# Comma-separated origins allowed for the Restream OAuth success redirect
RESTREAM_OAUTH_ALLOWED_ORIGINS=
RESTREAM_TOKEN_ENCRYPTION_KEY=
RESTREAM_BRIDGE_API_KEY=
# Base64-encoded 32-byte AES key for one-time Restream speaker links
SPEAKER_LINK_SECRET=

# Accountabul Live media (Cloudflare RealtimeKit) — SECRET, server only
# Use separate RealtimeKit apps for staging and production.
# The API token needs Realtime / Realtime Admin permissions and must never reach the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIMEKIT_APP_ID=
CLOUDFLARE_REALTIMEKIT_API_TOKEN=
# Preset names created in the RealtimeKit dashboard or Presets API.
CLOUDFLARE_REALTIMEKIT_HOST_PRESET=accountabul_host
CLOUDFLARE_REALTIMEKIT_VIEWER_PRESET=accountabul_viewer
# Optional replay delivery only. RealtimeKit records the live room; Stream can host copied replays.
CLOUDFLARE_STREAM_API_TOKEN=

# Palisade pilot — leave unset until sandbox diligence is approved
PALISADE_API_KEY=
PALISADE_WEBHOOK_PUBLIC_KEY=

# Circle USDC live tips — keep disabled until sandbox keys and counsel gates pass.
# CIRCLE_USDC_TIPS_ENABLED=true is required; without it the adapter stays disabled.
CIRCLE_USDC_TIPS_ENABLED=false
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_WEBHOOK_PUBLIC_KEY=
# Required when CIRCLE_USDC_TIPS_ENABLED=true. Inbound webhooks fail closed without a matching key id.
CIRCLE_WEBHOOK_KEY_ID=
# Required when CIRCLE_USDC_TIPS_ENABLED=true. Inbound webhooks fail closed without it.
CIRCLE_USDC_TOKEN_ID=
# When true, quotes use Base mainnet. Leave false for Base Sepolia.
CIRCLE_LIVE_MODE=false
# Webhook URL: ${PUBLIC_SITE_URL}/api/public/webhooks/circle

# Set true only when Cloudflare overwrites CF-Connecting-IP (Lovable/production).
# Off by default so a caller-supplied header cannot mint a fresh rate-limit bucket.
RATE_LIMIT_TRUST_CF=false

# Absolute public URL of the deployed site, used for Stripe redirect URLs
PUBLIC_SITE_URL=

# Public https URL of Lenders List (https://lenders.accountabul.com). Empty hides every link.
# Local only: http://localhost:5173 is accepted in Vite DEV so the nav can reach the sibling app.
VITE_LENDERS_LIST_URL=

# Market data — SECRET, server only. Demo header: x-cg-demo-api-key
# Empty still uses CoinGecko's public Demo endpoint; a key raises the quota ceiling.
COINGECKO_API_KEY=
# MARKET_DATA_PROVIDER=coingecko
# MARKET_DATA_CACHE_MS=360000
# Comma-separated CoinGecko IDs pinned to the front of the ticker. Empty disables featured placement.
MARKET_FEATURED_ASSETS=ripple,ripple-usd
# CoinPaprika is implemented but stays off until its commercial license is verified.
# MARKET_DATA_ALLOW_COINPAPRIKA=true
# MARKET_DATA_PROVIDER=coinpaprika

# Accountabul Live hop-on alerts - SECRET, server only
# Email is sent through Resend. Leave unset to suppress email alerts entirely.
RESEND_API_KEY=
LIVE_ALERTS_FROM_EMAIL=
# SMS is sent through Twilio and only ever to people who opted in.
# Leave unset to suppress SMS alerts entirely.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Accountabul Live side assistant - SECRET, server only
# Leave unset to disable the in-room lookup assistant.
ANTHROPIC_API_KEY=
